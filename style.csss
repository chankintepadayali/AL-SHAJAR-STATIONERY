:root {
  --bg-color: #f0f0f0;
  --text-color: #333;
  --header-bg: #fff;
  --card-bg: #fff;
  --price-color: #27ae60;
  --btn-bg: #3498db;
  --btn-text: #fff;
}

[data-theme="dark"] {
  --bg-color: #1a1a1a;
  --text-color: #f0f0f0;
  --header-bg: #2d2d2d;
  --card-bg: #2d2d2d;
  --price-color: #2ecc71;
  --btn-bg: #2980b9;
  --btn-text: #fff;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  margin: 0;
  padding: 0;
  background-color: var(--bg-color);
  color: var(--text-color);
  transition: background-color 0.3s, color 0.3s;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Nav Bar */
nav {
  background-color: var(--header-bg);
  padding: 15px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  animation: fadeIn 1s ease-in-out;
}

.nav-links {
  display: flex;
  gap: 20px;
  list-style: none;
  margin: 0;
  padding: 0;
}

.nav-links a {
  color: var(--text-color);
  text-decoration: none;
  font-weight: bold;
  transition: color 0.3s;
}

/* Language & Theme Controls (Sub-bar) */
.sub-bar {
  background-color: var(--header-bg);
  padding: 8px 20px;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 15px;
  border-top: 1px solid rgba(0,0,0,0.05);
  font-size: 0.9em;
}

select { 
  padding: 5px 10px; 
  border-radius: 5px; 
  border: 1px solid #ccc; 
  font-size: 0.9em; 
  background-color: var(--card-bg);
  color: var(--text-color);
}

/* Header Area */
header {
  background-color: var(--header-bg);
  padding: 30px;
  margin: 20px auto;
  border-radius: 12px;
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
  max-width: 900px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  animation: fadeIn 1.2s ease-in-out;
}

.logo { 
  width: 150px; 
  height: auto;
  border-radius: 8px;
}

/* Search Box */
.search-container {
  flex: 1;
  display: flex;
  justify-content: center;
  max-width: 600px;
  margin: 0 auto;
}

.search-box {
  display: flex;
  width: 100%;
  border: 2px solid var(--btn-bg);
  border-radius: 30px;
  overflow: hidden;
  background-color: var(--card-bg);
}

.category-select {
  border: none;
  background-color: transparent;
  padding: 10px 15px;
  font-size: 0.9em;
  border-right: 1px solid #ccc;
  outline: none;
  cursor: pointer;
}

.search-input {
  flex: 1;
  border: none;
  padding: 12px 18px;
  font-size: 1em;
  outline: none;
  background-color: transparent;
  color: var(--text-color);
}

/* Products Section */
.products { 
  display: flex; 
  justify-content: center; 
  gap: 20px; 
  flex-wrap: wrap; 
  margin-top: 30px; 
  padding: 0 10px;
}

.product { 
  border: 1px solid #ddd; 
  padding: 20px; 
  width: 220px; 
  border-radius: 10px; 
  background-color: var(--card-bg);
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  transition: transform 0.3s ease;
  text-align: center;
}

.price { 
  color: var(--price-color); 
  font-weight: bold; 
  font-size: 1.2em; 
  margin-bottom: 15px; 
}

button { 
  background-color: var(--btn-bg); 
  color: var(--btn-text); 
  border: none; 
  padding: 10px 20px; 
  border-radius: 5px; 
  cursor: pointer; 
  font-size: 1em; 
  width: 100%;
}

footer { 
  margin-top: 60px; 
  padding: 20px; 
  text-align: center; 
  background-color: var(--header-bg); 
}

/* 📱 MOBILE RESPONSIVE MEDIA QUERIES (ഫോണിനു വേണ്ടിയുള്ള മാറ്റങ്ങൾ) */
@media screen and (max-width: 768px) {
  nav {
    flex-direction: column;
    gap: 10px;
    text-align: center;
  }

  .nav-links {
    gap: 12px;
    font-size: 0.9em;
    flex-wrap: wrap;
    justify-content: center;
  }

  .sub-bar {
    justify-content: center;
    gap: 10px;
  }

  header {
    flex-direction: column;
    padding: 20px;
    margin: 10px;
    text-align: center;
  }

  .logo {
    width: 120px;
  }

  .search-container {
    width: 100%;
  }

  .search-box {
    flex-direction: column;
    border-radius: 15px;
  }

  .category-select {
    border-right: none;
    border-bottom: 1px solid #ccc;
    padding: 8px;
  }

  .search-input {
    padding: 10px;
  }

  .product {
    width: 100%; /* ഫോണിൽ പ്രോഡക്റ്റുകൾ സ്ക്രീൻ വിഡ്ത്തിൽ വരും */
    max-width: 300px;
  }
}
